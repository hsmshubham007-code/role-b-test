# Groq API Configuration for Role B (Data Service)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Neon PostgreSQL (future: replace SQLite with hosted Postgres)
# Format: postgresql://user:password@ep-xxx-yyy.region.aws.neon.tech/dbname?sslmode=require
NEONDB_URL=postgresql://user:password@host/dbname?sslmode=require
